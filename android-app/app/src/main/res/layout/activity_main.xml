<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Animated aurora gradient + drifting light orbs -->
    <com.workbuddy.sudoku.AuroraBackgroundView
        android:id="@+id/aurora"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Main game UI -->
    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.16"
                    android:textColor="@color/text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/subtitle"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.26"
                    android:textColor="@color/accent"
                    android:layout_marginTop="1dp" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="@string/timer_initial"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:textColor="@color/text" />
        </LinearLayout>

        <!-- Difficulty segmented control -->
        <com.workbuddy.sudoku.SegmentedControlView
            android:id="@+id/difficulty"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="16dp" />

        <!-- Progress -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/progress"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.16"
                android:textColor="@color/muted" />

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_weight="1"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="8dp"
                android:max="81"
                android:indeterminate="false"
                android:progressDrawable="@drawable/progress_track" />

            <TextView
                android:id="@+id/progressText"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0/81"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:textColor="@color/accent" />
        </LinearLayout>

        <!-- Status row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/mistakes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MISTAKES  0"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:textColor="@color/muted" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/checkToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:paddingLeft="11dp"
                android:paddingRight="11dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="@string/check_off"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:textColor="@color/muted" />
        </LinearLayout>

        <!-- Board card -->
        <FrameLayout
            android:id="@+id/boardCard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:padding="5dp"
            android:elevation="10dp"
            android:background="@drawable/bg_board_card">

            <com.workbuddy.sudoku.SudokuBoardView
                android:id="@+id/board"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />
        </FrameLayout>

        <!-- Action row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:weightSum="5">

            <TextView
                android:id="@+id/actionUndo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="2dp"
                android:gravity="center"
                android:drawableTop="@drawable/ic_undo"
                android:drawablePadding="3dp"
                android:text="@string/action_undo"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="@color/muted" />

            <TextView
                android:id="@+id/actionErase"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="2dp"
                android:gravity="center"
                android:drawableTop="@drawable/ic_erase"
                android:drawablePadding="3dp"
                android:text="@string/action_erase"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="@color/muted" />

            <TextView
                android:id="@+id/actionNotes"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="2dp"
                android:gravity="center"
                android:drawableTop="@drawable/ic_notes"
                android:drawablePadding="3dp"
                android:text="@string/action_notes"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="@color/muted" />

            <TextView
                android:id="@+id/actionHint"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="2dp"
                android:gravity="center"
                android:drawableTop="@drawable/ic_hint"
                android:drawablePadding="3dp"
                android:text="@string/action_hint"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="@color/muted" />

            <TextView
                android:id="@+id/actionNew"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="2dp"
                android:gravity="center"
                android:drawableTop="@drawable/ic_new"
                android:drawablePadding="3dp"
                android:text="@string/action_new"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="@color/muted" />
        </LinearLayout>

        <!-- Interactive number keyboard -->
        <com.workbuddy.sudoku.NumberPadView
            android:id="@+id/numberPad"
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:layout_marginTop="12dp" />

    </LinearLayout>

    <!-- Puzzle generation overlay -->
    <FrameLayout
        android:id="@+id/genOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="22dp"
            android:background="@drawable/bg_win_card">

            <ProgressBar
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/generating"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="@color/text" />
        </LinearLayout>
    </FrameLayout>

    <!-- Win screen -->
    <FrameLayout
        android:id="@+id/winOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/winCard"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="26dp"
            android:elevation="14dp"
            android:background="@drawable/bg_win_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✦"
                android:textSize="40sp"
                android:textColor="@color/accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/win_title"
                android:textSize="21sp"
                android:textStyle="bold"
                android:letterSpacing="0.14"
                android:textColor="@color/text" />

            <TextView
                android:id="@+id/winStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:lineSpacingExtra="7dp"
                android:textSize="12sp"
                android:textColor="@color/muted" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="22dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/winClose"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:text="@string/win_close"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:textColor="@color/muted" />

                <View
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <TextView
                    android:id="@+id/winAgain"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/win_again"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:textColor="#FFFFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Confetti sits on top of everything but never consumes touches -->
    <com.workbuddy.sudoku.ConfettiView
        android:id="@+id/confetti"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:visibility="gone" />

</FrameLayout>
